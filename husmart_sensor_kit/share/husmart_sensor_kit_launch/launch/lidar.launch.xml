    </group>
    <!-- JT128 arka sol: 192.168.1.207:2374 -->
    <group>
      <push-ros-namespace namespace="jt128_rear_left"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml" if="$(var enable_jt128_rear_left)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear_left"/>
        <arg name="sensor_ip" value="192.168.1.207"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2374"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="false"/>
        <arg name="vehicle_mirror_param_file" value="$(find-pkg-share husmart_sensor_kit_launch)/config/self_body_crop.param.yaml"/>
        <arg name="ring_outlier_filter_node_param_path" value="$(find-pkg-share husmart_sensor_kit_launch)/config/ring_outlier_filter_node.param.yaml"/>
        <arg name="container_name" value="pointcloud_container"/>
        <arg name="udp_only" value="true"/>
      </include>
    </group>
    <!-- JT128 arka sağ: 192.168.1.208:2375 -->
    <group>
      <push-ros-namespace namespace="jt128_rear_right"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml" if="$(var enable_jt128_rear_right)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear_right"/>
        <arg name="sensor_ip" value="192.168.1.208"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2375"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="false"/>
        <arg name="vehicle_mirror_param_file" value="$(find-pkg-share husmart_sensor_kit_launch)/config/self_body_crop.param.yaml"/>
        <arg name="ring_outlier_filter_node_param_path" value="$(find-pkg-share husmart_sensor_kit_launch)/config/ring_outlier_filter_node.param.yaml"/>
        <arg name="container_name" value="pointcloud_container"/>
        <arg name="udp_only" value="true"/>
      </include>
    </group>
    <!-- JT128 arka: 192.168.1.209:2376 -->
    <group>
      <push-ros-namespace namespace="jt128_rear"/>
      <include file="$(find-pkg-share common_sensor_launch)/launch/velodyne_VLP16.launch.xml" if="$(var enable_jt128_rear)">
        <arg name="max_range" value="60.0"/>
        <arg name="min_range" value="0.05"/>
        <arg name="sensor_frame" value="jt128_rear"/>
        <arg name="sensor_ip" value="192.168.1.209"/>
        <arg name="host_ip" value="$(var host_ip)"/>
        <arg name="data_port" value="2376"/>
        <arg name="scan_phase" value="0.0"/>
        <arg name="launch_driver" value="false"/>
