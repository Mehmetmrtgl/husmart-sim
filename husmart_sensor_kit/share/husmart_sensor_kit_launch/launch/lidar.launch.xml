        <arg name="container_name" value="pointcloud_container"/>
        <arg name="udp_only" value="true"/>
      </include>
    </group>
    <load_composable_node target="$(var pointcloud_container_name)">
      <composable_node pkg="autoware_pointcloud_preprocessor" plugin="autoware::pointcloud_preprocessor::PointCloudConcatenateDataSynchronizerComponent" name="concatenate_data">
        <remap from="~/input/twist" to="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
        <remap from="output" to="/sensing/lidar/concatenated/pointcloud"/>
        <remap from="output_info" to="/sensing/lidar/concatenated/pointcloud_info"/>
        <param from="$(find-pkg-share husmart_sensor_kit_launch)/config/concatenate_and_time_sync_node.param.yaml"/>
      </composable_node>
    </load_composable_node>
  </group>
</launch>
